# Copia este archivo a .env y ajusta los valores. .env nunca se versiona.

# --- Capa 1: nube de Ollama (opcional) ---
# ollama.com → Settings → Keys. Sin clave, la capa se salta.
OLLAMA_API_KEY=
TAMA_CLOUD_MODEL=gemma4:31b-cloud
TAMA_CLOUD_FIRST_TOKEN_S=8

# --- Capa 2: Claude (opcional) ---
# console.anthropic.com. Sin clave, la capa se salta.
ANTHROPIC_API_KEY=
TAMA_CLAUDE_MODEL=claude-haiku-5-5
TAMA_CLAUDE_FIRST_TOKEN_S=8
# Tope de gasto mensual en US$ y precios por millón de tokens (entrada / salida).
TAMA_CLAUDE_MONTHLY_USD=5
TAMA_CLAUDE_USD_PER_MTOK_IN=0.10
TAMA_CLAUDE_USD_PER_MTOK_OUT=0.50

# --- Capa 3: Ollama local (siempre disponible, sin internet) ---
# En Docker Compose el default es http://host.docker.internal:11434;
# fuera de Docker, http://127.0.0.1:11434.
# OLLAMA_HOST=http://host.docker.internal:11434
TAMA_LOCAL_MODEL=qwen3:4b-instruct-2507-q4_K_M
TAMA_BACKGROUND_MODEL=qwen3:4b
TAMA_NUM_CTX=8192
# 0 = solo CPU y RAM.
TAMA_NUM_GPU=0
TAMA_THINK=false
TAMA_TIMEOUT=300

# --- Cascada ---
# 3 fallos seguidos abren el cortacircuitos de una capa por 5 minutos.
TAMA_BREAKER_FAILURES=3
TAMA_BREAKER_COOLDOWN_S=300
# Chequeo de conexión (TCP, sin enviar datos) y cada cuántos segundos se repite.
TAMA_CONNECTIVITY_PROBE=1.1.1.1:443
TAMA_CONNECTIVITY_TTL_S=30
# Tokens máximos del historial que se envía al modelo.
TAMA_HISTORY_MAX_TOKENS=2000
