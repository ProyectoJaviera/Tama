# Copia este archivo a .env y ajusta los valores. .env nunca se versiona.

# Ollama (corre nativo en el host). En Docker Compose el default es
# http://host.docker.internal:11434; fuera de Docker, http://127.0.0.1:11434.
# OLLAMA_HOST=http://host.docker.internal:11434
TAMA_LOCAL_MODEL=qwen3:8b
# Razonamiento del modelo ("thinking"). En CPU conviene apagado.
TAMA_THINK=false
# Segundos máximos de espera por respuesta del modelo local
TAMA_TIMEOUT=300

# Nube (a partir del Sprint 1; dejar vacío si no se usa)
TAMA_OLLAMA_CLOUD_API_KEY=
TAMA_ANTHROPIC_API_KEY=
