# Copia este archivo a .env y ajusta los valores. .env nunca se versiona.

# --- Orden de la cascada ---
# Claude primero; la local va siempre (al final si no se nombra).
TAMA_CASCADE_ORDER=claude,nube,local

# --- Capa 1: nube de Ollama ---
# Directo a ollama.com con API keys (ollama.com → Settings → Keys), en orden: si la 1 agota su
# cuota se usa la 2, luego la 3, y si ninguna sirve se baja a Claude. Sin keys, la capa se apaga.
TAMA_CLOUD_MODEL=gemma4:31b-cloud
TAMA_CLOUD_FIRST_TOKEN_S=8
OLLAMA_API_KEY_1=
OLLAMA_API_KEY_2=
OLLAMA_API_KEY_3=
# Una key agotada se reintenta tras este tiempo (o lo que diga Ollama con Retry-After).
TAMA_CLOUD_KEY_COOLDOWN_S=3600
# Las evals usan solo esta key (0 = todas en orden).
TAMA_EVALS_OLLAMA_KEY=3

# --- Capa 2: Claude (opcional) ---
# console.anthropic.com. Sin clave, la capa se salta.
ANTHROPIC_API_KEY=
TAMA_CLAUDE_ENABLED=true
TAMA_CLAUDE_MODEL=claude-haiku-5-5
TAMA_CLAUDE_FIRST_TOKEN_S=8
# Esfuerzo de razonamiento: low (rápido, para charlar) | medium | high | xhigh | max.
TAMA_CLAUDE_EFFORT=low
# Tope de gasto mensual en US$ y precios por millón de tokens (entrada / salida).
TAMA_CLAUDE_MONTHLY_USD=5
TAMA_CLAUDE_USD_PER_MTOK_IN=0.10
TAMA_CLAUDE_USD_PER_MTOK_OUT=0.50

# --- Capa 3: Ollama local (siempre disponible, sin internet) ---
# En Docker Compose el default es http://host.docker.internal:11434;
# fuera de Docker, http://127.0.0.1:11434.
# OLLAMA_HOST=http://host.docker.internal:11434
TAMA_LOCAL_MODEL=qwen3:4b-instruct-2507-q8_0
TAMA_BACKGROUND_MODEL=qwen3:4b-instruct-2507-q8_0
TAMA_NUM_CTX=8192
# 0 = solo CPU y RAM.
TAMA_NUM_GPU=0
# Hilos de CPU para el modelo local (10 de los 12 del i5-10400F; 0 = lo que decida Ollama)
TAMA_NUM_THREAD=10
TAMA_THINK=false
TAMA_TIMEOUT=300

# --- Cascada ---
# 3 fallos seguidos abren el cortacircuitos de una capa por 5 minutos.
TAMA_BREAKER_FAILURES=3
TAMA_BREAKER_COOLDOWN_S=300
# Chequeo de conexión (TCP, sin enviar datos) y cada cuántos segundos se repite.
TAMA_CONNECTIVITY_PROBE=1.1.1.1:443
TAMA_CONNECTIVITY_TTL_S=30
# En el chat, revisa la red cada N segundos; al detectar un corte precarga el modelo local.
TAMA_CONNECTIVITY_WATCH_S=5
# true = mantener el modelo local siempre en RAM (3-4 GB), para responder rápido aun sin red.
TAMA_LOCAL_KEEP_WARM=false
# La capa local busca en la memoria por las palabras del mensaje (ADR 0003).
TAMA_LOCAL_AUTO_RECALL=true
# Tokens máximos del historial que se envía al modelo.
TAMA_HISTORY_MAX_TOKENS=2000

# --- Herramientas (servidores MCP de config/mcp.toml) ---
TAMA_MCP_ENABLED=true
# Carpeta donde el servidor de archivos puede leer y escribir (nunca fuera de ella).
TAMA_WORKDIR=data/trabajo
# En Docker: carpeta del host que se monta como /trabajo.
# TAMA_WORKDIR_HOST=./trabajo
TAMA_TOOLS_MAX=18
# Perfil (nucleo.md) y export del grafo.
TAMA_MEMORY_DIR=memoria
# Reflexión en inactividad: ordena la memoria y escribe el diario con el modelo local.
TAMA_REFLECTION=true
TAMA_REFLECTION_IDLE_MIN=20
TAMA_REFLECTION_MIN_FREE_GB=6
# Interfaz web (`tama web`).
TAMA_WEB_HOST=127.0.0.1
TAMA_WEB_PORT=8765
# Motor proactivo.
TAMA_PROACTIVE=true
TAMA_TIMEZONE=America/Santiago
TAMA_QUIET_START=22
TAMA_QUIET_END=8
TAMA_DAILY_CAP=3
TAMA_MORNING_HOUR=8
# Si Tama estuvo apagada en la mañana, el resumen sale al iniciar solo antes de esta hora.
TAMA_SUMMARY_UNTIL_HOUR=12
TAMA_STALE_GOAL_DAYS=14
# ntfy autoalojado (docker compose --profile ntfy up -d). El tema debe ser largo y aleatorio.
TAMA_NTFY_URL=
TAMA_NTFY_TOPIC=
# Dirección de ntfy que usa el celular por Tailscale (`uv run tama celular` la muestra).
TAMA_NTFY_PUBLIC_URL=
# Solo con iPhone: https://ntfy.sh despierta la app (recibe un identificador, nunca el texto).
TAMA_NTFY_UPSTREAM=
# Prioridad de los recordatorios en ntfy: high suena y sale con el celular bloqueado.
TAMA_NTFY_PRIORITY_RECORDATORIO=high

# --- Celular (Sprint 9) ---
# Nombre del PC en Tailscale (p. ej. mi-pc.tail1234.ts.net) para entrar con `tailscale serve`.
TAMA_WEB_TAILSCALE_HOST=
# Si se indica, solo esa cuenta de Tailscale (correo) puede entrar.
TAMA_WEB_TAILSCALE_USER=
# Desde fuera del PC se entra con passkey (Sprint 10). En 127.0.0.1 no hay login.
TAMA_WEB_LOGIN_REMOTE=true
TAMA_WEB_SESSION_DAYS=30

# --- Voz (Sprint 11) ---
# Modelos: uv run python scripts/descargar_voz.py (una vez). Sin key de ElevenLabs habla Piper.
ELEVENLABS_API_KEY=
# De `uv run tama voz disenar` o `uv run tama voz listar`.
TAMA_ELEVENLABS_VOICE_ID=
TAMA_ELEVENLABS_MONTHLY_CHARS=10000
